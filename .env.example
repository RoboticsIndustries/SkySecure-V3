# Copy to .env and replace placeholder values. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DSN=postgresql://skysecure:replace-with-the-same-strong-password@localhost:5432/skysecure

KAFKA_BOOTSTRAP=localhost:9092
REDIS_URL=redis://localhost:6379/0
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
OPERATOR_API_KEY=

# Keys must exactly match MLAT_RECEIVER_LOCATIONS and every value must be
# nonempty and distinct. Replace all examples with independently generated secrets.
MLAT_RECEIVER_API_KEYS={"receiver-london":"replace-with-distinct-secret-1","receiver-paris":"replace-with-distinct-secret-2","receiver-brussels":"replace-with-distinct-secret-3","receiver-amsterdam":"replace-with-distinct-secret-4"}
MLAT_SOLVER_SIGNING_KEY=replace-with-an-independent-strong-random-signing-secret

OPENSKY_USERNAME=
OPENSKY_PASSWORD=
ADSB_FALLBACK_LAT=39.9526
ADSB_FALLBACK_LON=-75.1652
ADSB_FALLBACK_RADIUS_NM=250
LOG_LEVEL=INFO
